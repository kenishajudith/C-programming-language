#include <stdio.h>

int main() {
    int N, i, j;
    scanf("%d", &N);
    int a[100];
    for(i = 0; i < N; i++) {
        scanf("%d", &a[i]);
    }

    printf("unique elements are:");
    for(i = 0; i < N; i++) {
        int count = 0;
        for(j = 0; j < N; j++) {
            if(a[i] == a[j] && i != j) {
                count++;
                break;
            }
        }
        if(count == 0) {
            printf("%d ", a[i]);
        }
    }
    return 0;
}
