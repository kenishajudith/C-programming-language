#include <stdio.h>

int main() {
    int a[100], b[100], N, i, flag = 0;

    scanf("%d", &N);
    for(i = 0; i < N; i++) {
        scanf("%d", &a[i]);
    }

    for(i = 0; i < N; i++) {
        scanf("%d", &b[i]);
    }

    for(i = 0; i < N; i++) {
        if(a[i] != b[i]) {
            printf("\n not eq");
            return 0;
        }
    }

    printf("the two arrays are equal");
    return 0;
}
