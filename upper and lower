

#include<string.h>

#include<ctype.h>

#include<stdio.h>

int main()

{

char str[100];

printf("Enter the string:");

fgets(str,sizeof(str),stdin);

str[strcspn(str,"\n")]='\0';

for(int i=0;str[i]!='\0';i++)

{

if (islower(str[i]))

str[i]=toupper(str[i]);}



printf("upper case: %s\n",str);
}
